# Local Postgres from the repo-root docker-compose.yml (`make db-up`). Port 5433,
# not 5432, so the container cannot collide with a native Postgres install.
# In deployed environments this is the managed Postgres URL from your provider
# — Neon, RDS, Fly, Railway, whichever — and should include ?sslmode=require.
DATABASE_URL=postgresql://rcpt:rcpt@127.0.0.1:5433/rcpt

# Required, no fallback. Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=YOUR_DJANGO_SECRET_KEY

# Defaults to False when unset, so a deployment that forgets this is not
# accidentally running in debug mode.
DJANGO_DEBUG=True

# Comma-separated hostnames. Only needed when DJANGO_DEBUG is False; under
# debug, Django already accepts localhost.
# DJANGO_ALLOWED_HOSTS=api.example.edu.au

# Comma-separated browser origins allowed to call the API. Defaults to the
# Vite dev origin below, so local work needs no entry here.
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Force TLS on the database connection. Defaults to on unless DJANGO_DEBUG is
# True. The local Docker container serves no certificate, so leave this unset
# locally — set it to False only where you genuinely have a plaintext database
# (for example a CI service container).
# DATABASE_SSL=True
