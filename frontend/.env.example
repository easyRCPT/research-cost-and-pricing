# Leave this empty in development.
#
# Empty means the app calls /api on its own origin, which Vite proxies to
# Django (see vite.config.ts). Pointing it at http://127.0.0.1:8000 instead
# makes the API a different site from the page, and the session cookie is
# SameSite=Lax: the browser then keeps the cookie to itself and nothing is
# ever signed in. Set it only for a deployment that really does serve the API
# from another origin, and add that origin to DJANGO_CORS_ALLOWED_ORIGINS and
# DJANGO_CSRF_TRUSTED_ORIGINS.
VITE_API_URL=
